DATABASE_URL="postgresql://casar:casar@localhost:5433/casar_angola?schema=public"
API_PORT=4000
# Persistently mounted directory for supplier portfolio uploads. Back this up
# with the database; do not use an ephemeral container filesystem in production.
PORTFOLIO_STORAGE_DIR=./data/vendor-portfolio
# Persistently mounted directory for editorial guide cover uploads.
GUIDE_COVER_STORAGE_DIR=./data/guide-covers
# Persistently mounted directory for venue gallery uploads.
VENUE_PHOTO_STORAGE_DIR=./data/venue-photos
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional HTML-tag verification token from Google Search Console.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1
# Number of trusted reverse proxy hops. Set this only when the API is behind
# a proxy that overwrites X-Forwarded-For (for example, the web server).
TRUST_PROXY_HOPS=0
# Optional: create the initial administrator automatically when the API starts.
# Set both values in Coolify; keep them stable and use a strong password.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional: GA4 reports shown in the admin panel. Grant this service account
# Viewer access to the GA4 property and enable the Google Analytics Data API.
GA4_ENABLED=false
GA4_PROPERTY_ID=""
GA4_SERVICE_ACCOUNT_EMAIL=""
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Transactional email through Resend. Disabled unless explicitly enabled.
RESEND_ENABLED=false
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# Generate with: openssl rand -base64 32. Required when NODE_ENV=production.
RSVP_TOKEN_ENCRYPTION_KEY=""
# Generate with: openssl rand -base64 32. Keep stable; existing files require this key to decrypt.
PROJECT_DOCUMENT_ENCRYPTION_KEY=""
